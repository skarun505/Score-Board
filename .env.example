# Server Environment Variables
PORT=4000
JWT_SECRET=generate_a_secure_long_random_string_here
TV_KEY=generate_a_secure_tv_key_here
DB_PATH=./data/dashboard.db
TZ_NAME=Asia/Kolkata
DAY_START_HOUR=0
UNDO_WINDOW_SEC=10
DUPLICATE_WINDOW_SEC=20
MILESTONE_EVERY=10
ADMIN_CODE=ADMIN
ADMIN_PIN=123456
CORS_ORIGIN=*

# Tier 2 Cloud PostgreSQL Persistence (Supabase, Neon, Render Postgres)
# Leave blank for local offline mode. Provide to enable zero-loss cloud persistence across Render restarts.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

